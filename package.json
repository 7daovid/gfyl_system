{
  "name": "qgzx-hours",
  "version": "1.0.0",
  "private": true,
  "description": "勤工助学工时填报系统 - Cloudflare Pages + D1 全免费方案",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create qgzx-hours",
    "db:init": "wrangler d1 execute qgzx-hours --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute qgzx-hours --remote --file=./seed.sql",
    "db:init:local": "wrangler d1 execute qgzx-hours --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute qgzx-hours --local --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
